APP_TIMEZONE=UTC
# Development default. Public rollout requires an explicit bind and firewall rules.
SFTP_BIND_ADDRESS=127.0.0.1
SFTP_PORT=15100
FTP_BIND_ADDRESS=127.0.0.1
FTP_PORT=15101
# REQUIRED when enabling the legacy profile. Replace with the public IPv4 in production.
FTP_PUBLIC_ADDRESS=127.0.0.1
FTP_PASSIVE_MIN=15110
FTP_PASSIVE_MAX=15119
DEPLOYMENT_HOST=mkbackup.example.com
# Optional HTTPS origin override, e.g. for a nonstandard HAProxy TLS port.
ENROLLMENT_BASE_URL=
# HAProxy terminates HTTPS :443 and forwards HTTP to this backend.
# If HAProxy is on another host, use this host's private IP and allow only HAProxy.
CADDY_BIND_ADDRESS=127.0.0.1
CADDY_PORT=15102
# Required only with --profile admin; generate a unique value of at least 16 characters.
# Recreate the admin service after rotation; all existing sessions are invalidated.
ADMIN_PASSWORD=
FTP_PASSWORDS_FILE=./secrets/ftp_passwords.json
ENROLLMENT_KEY_FILE=./secrets/enrollment.key
# Snapshot archives and run retention-preview before changing to 1.
RETENTION_ENABLED=0
ROUTERS_FILE=./secrets/routers.json
SSH_HOST_RSA_KEY_FILE=./secrets/ssh_host_rsa_key
SSH_HOST_RSA_PUBLIC_KEY_FILE=./secrets/ssh_host_rsa_key.pub
SSH_HOST_ED25519_KEY_FILE=./secrets/ssh_host_ed25519_key
COLLECT_INTERVAL_SECONDS=2
